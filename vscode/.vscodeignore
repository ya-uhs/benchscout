src/**
# the extension ships as one bundled file (dist/, `npm run bundle`): not tsc's out/ (the tests use that), and no
# node_modules (vsce --no-dependencies); their license texts are in THIRD_PARTY_NOTICES.txt (packaging/notices.py)
out/**
node_modules/**
test/**
tsconfig.json
**/*.map
.gitignore
scripts/**
.vscode-test/**
e2e-out/**
# a developer's environment files: package-platform.mjs skips vsce's secret and .env scan for the frozen core
**/.env
**/.env.*
# the LGPL libraries' source: published beside the .vsix, not in it (packaging/bundle_tools.py)
lgpl-sources/**
