{
  "name": "benchscout",
  "displayName": "benchscout",
  "description": "Finds what is on your hardware bench, lets your AI agent work on the devices you pick, and asks you before anything changes device state.",
  "version": "0.1.0",
  "publisher": "benchscout",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.benchscout"
  ],
  "contributes": {
    "commands": [
      {
        "command": "benchscout.start",
        "title": "benchscout: Open bench",
        "category": "benchscout"
      },
      {
        "command": "benchscout.rescan",
        "title": "benchscout: Rescan",
        "category": "benchscout"
      },
      {
        "command": "benchscout.stop",
        "title": "benchscout: Stop",
        "category": "benchscout"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "benchscout",
          "title": "benchscout",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "benchscout": [
        {
          "type": "webview",
          "id": "benchscout.panel",
          "name": "Inbox"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "benchscout",
        "label": "benchscout"
      }
    ],
    "configuration": {
      "title": "benchscout",
      "properties": {
        "benchscout.corePath": {
          "type": "string",
          "default": "",
          "description": "Path to the benchscout executable. Empty: the one bundled with the extension, else `benchscout` on PATH."
        },
        "benchscout.agent": {
          "type": "string",
          "enum": [
            "",
            "copilot",
            "claude"
          ],
          "default": "",
          "enumDescriptions": [
            "Not chosen yet: benchscout asks in the inbox",
            "GitHub Copilot CLI, woken over ACP",
            "Claude Code, woken with `claude -p` (your own install and sign-in)"
          ],
          "description": "Which agent benchscout wakes. benchscout never switches to another one on its own."
        },
        "benchscout.maxTurnsPerHour": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Budget: at most this many agent turns per hour; past it, benchscout pauses and says so."
        },
        "benchscout.autonomy": {
          "type": "string",
          "enum": [
            "auto",
            "suggest"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Wake the agent when a watched device crashes or resets",
            "Only offer to investigate; the human decides"
          ],
          "description": "What benchscout does when it notices something on a watched device."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test --test-concurrency=1 --test-timeout=120000 test/*.test.mjs",
    "package": "npm run compile && vsce package --skip-license --allow-missing-repository -o benchscout.vsix",
    "package:platform": "npm run compile && node scripts/package-platform.mjs",
    "ui-check": "node scripts/ui-check.mjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.2.0",
    "cross-spawn": "^7.0.6"
  }
}
